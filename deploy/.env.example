# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
#
# Generate each secret with:  openssl rand -base64 48

# ── Domain ────────────────────────────────────────────────────────────────────
# The hostname Caddy issues a TLS certificate for. Its A record must already
# point at this VPS.
API_DOMAIN=driftwatch-api.example.com

# ── Datastores (internal to the compose network) ──────────────────────────────
POSTGRES_PASSWORD=

# ── Server secrets ────────────────────────────────────────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=
# Only needed if you deploy the Cloudflare webhook worker; must match the
# worker's DRIFTWATCH_SECRET.
WEBHOOK_SECRET=

# ── GitHub OAuth (sign-in) ────────────────────────────────────────────────────
# Callback URL on the OAuth App must be exactly:
#   ${BACKEND_URL}/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── URLs ──────────────────────────────────────────────────────────────────────
BACKEND_URL=https://driftwatch-api.example.com
DASHBOARD_URL=https://driftwatch.pages.dev
# Comma-separated. A Cloudflare Pages production origin also allows its
# *.pages.dev preview subdomains automatically.
ALLOWED_ORIGIN=https://driftwatch.pages.dev

# ── Optional ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GITHUB_TOKEN=
DISCORD_WEBHOOK_URL=
LOG_LEVEL=info
