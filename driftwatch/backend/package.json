{
  "name": "driftwatch-backend",
  "version": "1.0.0",
  "private": true,
  "description": "DriftWatch backend — compares live Docker state against the docker-compose.yml declared in git.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "driftwatch-agent": "dist/agent/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:agent": "tsx watch src/agent/main.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "agent": "node dist/agent/main.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "yaml": "^2.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/dockerode": "^3.3.34",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
